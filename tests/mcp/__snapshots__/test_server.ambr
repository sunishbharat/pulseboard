   {
    "annotations": {
     "destructiveHint": false,
     "idempotentHint": true,
     "openWorldHint": true,
     "readOnlyHint": true
    },
    "description": "Plan a Jira board: forecast end, confidence, top warnings and plan_id.",
    "inputSchema": {
     "additionalProperties": false,
     "properties": {
      "board_link": {
       "type": "string"
      },
      "detail": {
       "default": "summary",
       "description": "Response detail.",
       "enum": [
