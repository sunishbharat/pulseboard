        "standard",
        "full"
       ],
       "type": "string"
      },
      "include_summaries": {
       "default": true,
       "type": "boolean"
      }
     },
     "required": [
      "board_link"
     ],
     "type": "object"
    },
    "name": "pb_build_plan",
    "outputSchema": {
     "description": "A plan handle and its headline numbers.",
     "properties": {
      "confidence": {
       "anyOf": [
        {
         "description": "Confidence in a forecast.",
         "enum": [
          "high",
          "medium",
          "low"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "confidence_reason": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
