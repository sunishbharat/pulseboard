# Pulseboard credentials, one set per configured site ID: PULSEBOARD_<SITE_ID>_EMAIL and
# PULSEBOARD_<SITE_ID>_TOKEN, with the ID upper-cased and hyphens as underscores.
# Export these in your shell or your MCP client's env block; Pulseboard does not read .env
# files. The OS keychain is preferred:
# `pulseboard site add` stores them under service "pulseboard", entries "<id>:email" and
# "<id>:token". Anonymous sites need nothing.

# Jira Cloud site "acme-cloud": account email + API token
PULSEBOARD_ACME_CLOUD_EMAIL=you@example.com
PULSEBOARD_ACME_CLOUD_TOKEN=

# Jira Data Center site "corp-dc": personal access token
PULSEBOARD_CORP_DC_TOKEN=

# Optional: settings file location (default: pulseboard.toml in the per-user config folder)
# PULSEBOARD_CONFIG=/path/to/pulseboard.toml
